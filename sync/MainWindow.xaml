<Window x:Class="BtoSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BTO Sync" Width="1440" Height="900" MinWidth="1180" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource Fg}" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/></Grid.RowDefinitions>

    <!-- ===== Top bar: sections as tabs, then profile, Steam, settings and Avvia Isaac ===== -->
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="28,0,20,0">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
          <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,10,0"/>
          <TextBlock Text="BTO Sync" FontSize="15" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="LaunchBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="16,8" Click="Launch_Click" VerticalAlignment="Center" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
            <TextBlock Text="Avvia Isaac"/>
          </StackPanel>
        </Button>
        <RadioButton x:Name="NavSettings" GroupName="nav" DockPanel.Dock="Right" Style="{StaticResource NavIcon}" Tag="&#xE713;" Checked="Nav_Checked" VerticalAlignment="Center"
                     ToolTip="Impostazioni" AutomationProperties.Name="Impostazioni" Margin="0"/>
        <RadioButton x:Name="NavInfo" GroupName="nav" DockPanel.Dock="Right" Style="{StaticResource NavIcon}" Tag="&#xE946;" Checked="Nav_Checked" VerticalAlignment="Center"
                     ToolTip="Info su BTO Sync" AutomationProperties.Name="Info"/>
        <StackPanel x:Name="SteamBox" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"
                    ToolTip="Per il Workshop BTO Sync si collega a Steam come Isaac: finché è collegato risulti in gioco su Isaac.">
          <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
          <TextBlock Text="Steam" Style="{StaticResource Sub}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
          <Button Content="Scollega" Style="{StaticResource Ghost}" Padding="8,2" FontSize="12" Margin="2,0,0,0" Click="Disconnect_Click"/>
        </StackPanel>
        <Border DockPanel.Dock="Right" CornerRadius="8" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center"
                Cursor="Hand" MouseLeftButtonUp="ProfileCard_Click" ToolTip="Profilo attivo: clicca per gestire i profili" MaxWidth="360">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
            <TextBlock x:Name="ActiveProfileText" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
            <TextBlock x:Name="ActiveProfileSub" Style="{StaticResource Sub}" FontSize="12" Margin="8,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton x:Name="NavOnline" GroupName="nav" Style="{StaticResource Nav}" Content="Partita" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavMods" GroupName="nav" Style="{StaticResource Nav}" Content="Mod" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavWs" GroupName="nav" Style="{StaticResource Nav}" Content="Workshop" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavProfiles" GroupName="nav" Style="{StaticResource Nav}" Content="Profili" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavSaves" GroupName="nav" Style="{StaticResource Nav}" Content="Salvataggi" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Workshop mod details: a dialog in the middle, the dark backdrop blocks what is behind ===== -->
    <Grid x:Name="WsModal" Grid.RowSpan="2" Panel.ZIndex="5" Visibility="Collapsed">
      <Border Background="#B8080A0E" MouseLeftButtonDown="ModalBackdrop_Click"/>
      <ContentControl x:Name="WsDetail" Width="840" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <Grid>
              <Border CornerRadius="12" Background="{StaticResource Bg}">  <!-- shadow on its own layer: the card text keeps ClearType -->
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="Black"/></Border.Effect>
              </Border>
              <Border Style="{StaticResource Card}" Padding="0" CornerRadius="12">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="26,20,20,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="9,7" VerticalAlignment="Top" Click="CloseDetail_Click"
                            ToolTip="Chiudi (Esc)" AutomationProperties.Name="Chiudi i dettagli">
                      <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                    </Button>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="22" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  </DockPanel>
                  <ScrollViewer Margin="26,16,12,24" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid Width="320" Height="320" VerticalAlignment="Top">
                          <Border CornerRadius="8" Background="{StaticResource Surface2}"/>
                          <Border CornerRadius="8">
                            <Border.Background><ImageBrush ImageSource="{Binding Preview, TargetNullValue={x:Null}}" Stretch="UniformToFill"/></Border.Background>
                          </Border>
                        </Grid>
                        <StackPanel Grid.Column="2">
                          <WrapPanel>
                            <Button x:Name="act" Content="{Binding ButtonText}" Style="{StaticResource Primary}" IsEnabled="{Binding CanAct}" Click="WsAct_Click" MinWidth="120" Margin="0,0,8,8"
                                    ToolTip="Vale per il profilo attivo"/>
                            <Button Style="{StaticResource Btn}" IsEnabled="{Binding CanAct}" Click="WsAddMenu_Click" Margin="0,0,8,8"
                                    ToolTip="Aggiungi a un altro profilo, senza cambiare le mod attive adesso">
                              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Altro profilo"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn}" Click="WsPage_Click" Margin="0,0,8,8">
                              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Pagina Workshop"/></StackPanel>
                            </Button>
                          </WrapPanel>
                          <ProgressBar Maximum="1" Value="{Binding Progress}" Margin="0,2,0,0" Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                          <TextBlock Text="{Binding Error}" Foreground="#F0616D" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                          <Border Height="18"/>
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,10"><TextBlock Text="Iscritti" Style="{StaticResource Sub}" FontSize="11"/><TextBlock Text="{Binding SubsFull}" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,0,10"><TextBlock Text="Voti positivi" Style="{StaticResource Sub}" FontSize="11"/><TextBlock Text="{Binding VotesText}" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                <StackPanel Grid.Row="1"><TextBlock Text="Dimensione" Style="{StaticResource Sub}" FontSize="11"/><TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Aggiornata" Style="{StaticResource Sub}" FontSize="11"/><TextBlock Text="{Binding UpdatedText}" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                              </Grid>

                              <Border CornerRadius="6" Padding="10,6" Margin="0,12,0,0" Background="#1B2D4D" Visibility="{Binding HasKind, Converter={StaticResource Vis}}">
                                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="#CFE0FF">
                                  <Run Text="{Binding KindText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=", secondo i tag dell'autore. Online servono comunque le stesse mod per tutti."/>
                                </TextBlock>
                              </Border>

                              <Border Background="#2A2315" BorderBrush="#4A3B1E" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                                      Visibility="{Binding HasRequires, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding RequiresText}" Foreground="#F1DEB4" FontSize="12" TextWrapping="Wrap"/>
                              </Border>

                              <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Background="{StaticResource Surface2}" CornerRadius="5" Padding="7,2,7,3" Margin="0,6,5,0">
                                      <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>

                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding LongDescription}" FontFamily="{StaticResource Prose}" Foreground="{StaticResource Body}" TextWrapping="Wrap" LineHeight="22" Margin="0,22,0,0"/>
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Installed}" Value="True"><Setter TargetName="act" Property="Style" Value="{StaticResource Danger}"/></DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>

    <!-- ===== Mod: details of the clicked mod, same dialog as the Workshop ===== -->
    <Grid x:Name="ModModal" Grid.RowSpan="2" Panel.ZIndex="5" Visibility="Collapsed">
      <Border Background="#B8080A0E" MouseLeftButtonDown="ModBackdrop_Click"/>
      <ContentControl x:Name="ModDetail" Width="840" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <Grid>
              <Border CornerRadius="12" Background="{StaticResource Bg}">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="Black"/></Border.Effect>
              </Border>
              <Border Style="{StaticResource Card}" Padding="0" CornerRadius="12">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="26,20,20,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="9,7" VerticalAlignment="Top" Click="CloseMod_Click"
                            ToolTip="Chiudi (Esc)" AutomationProperties.Name="Chiudi i dettagli">
                      <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                    </Button>
                    <TextBlock Text="{Binding NameText}" Style="{StaticResource H1}" FontSize="22" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  </DockPanel>
                  <ScrollViewer Margin="26,16,12,24" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid Width="200" Height="200" VerticalAlignment="Top">
                          <Border CornerRadius="8" Background="{StaticResource Surface2}"/>
                          <TextBlock Text="{Binding OriginIcon}" Style="{StaticResource Icon}" FontSize="48" Foreground="{Binding OriginBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                          <Border CornerRadius="8" Visibility="{Binding HasPreview, Converter={StaticResource Vis}}">
                            <Border.Background><ImageBrush ImageSource="{Binding Preview, TargetNullValue={x:Null}}" Stretch="UniformToFill"/></Border.Background>
                          </Border>
                        </Grid>
                        <StackPanel Grid.Column="2">
                          <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Badge}" BorderBrush="{Binding OriginBrush}" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Origin}" Foreground="{Binding OriginBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Sub}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                          <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource Primary}" Click="UpdateMod_Click" Margin="0,0,8,8" IsEnabled="{Binding Unlocked}"
                                    Visibility="{Binding CanUpdate, Converter={StaticResource Vis}}" Content="Aggiorna"/>
                            <Button Style="{StaticResource Btn}" Click="ModPage_Click" Margin="0,0,8,8" Visibility="{Binding HasPage, Converter={StaticResource Vis}}">
                              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Pagina Workshop"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn}" Click="ModFolder_Click" Margin="0,0,8,8">
                              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Apri cartella"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Danger}" Click="ModRemove_Click" Margin="0,0,8,8" IsEnabled="{Binding Unlocked}" Visibility="{Binding CanRemove, Converter={StaticResource Vis}}">
                              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Disinstalla"/></StackPanel>
                            </Button>
                          </WrapPanel>
                          <Border Background="#2A2315" BorderBrush="#4A3B1E" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0"
                                  Visibility="{Binding HasRequires, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding RequiresText}" Foreground="#F1DEB4" FontSize="12" TextWrapping="Wrap"/>
                          </Border>
                          <TextBlock Text="{Binding DetailsText}" Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding DescriptionText}" FontFamily="{StaticResource Prose}" Foreground="{StaticResource Body}" TextWrapping="Wrap" LineHeight="22" Margin="0,22,0,0"/>
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>

    <!-- ===== Updates found by "Cerca aggiornamenti": choose which ones ===== -->
    <Grid x:Name="UpdModal" Grid.RowSpan="2" Panel.ZIndex="6" Visibility="Collapsed">
      <Border Background="#B8080A0E" MouseLeftButtonDown="UpdBackdrop_Click"/>
      <Grid Width="580" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border CornerRadius="12" Background="{StaticResource Bg}">
          <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="Black"/></Border.Effect>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0" CornerRadius="12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="26,22,26,0">
              <TextBlock x:Name="UpdTitle" Style="{StaticResource H2}" FontSize="20"/>
              <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="Scegli cosa aggiornare. Le mod BTO non sono in elenco perché BTO Sync le tiene aggiornate da solo."/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,6,26,22">
              <Button Content="Annulla" Style="{StaticResource Btn}" Click="UpdCancel_Click" Margin="0,0,8,0"/>
              <Button x:Name="UpdSelBtn" Style="{StaticResource Btn}" Click="UpdSelected_Click" Margin="0,0,8,0">
                <TextBlock x:Name="UpdSelText" Text="Aggiorna selezionate"/>
              </Button>
              <Button Style="{StaticResource Primary}" Click="UpdAll_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Aggiorna tutto"/></StackPanel>
              </Button>
            </StackPanel>
            <ScrollViewer Margin="26,16,14,8" MaxHeight="420" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
              <ItemsControl x:Name="UpdList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding On, Mode=TwoWay}" Click="UpdToggle_Click" Margin="0,0,0,6" AutomationProperties.Name="{Binding Name}">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== Loading bar: shown by MainWindow.Loading/busy ===== -->
    <Grid x:Name="LoadBar" Grid.Row="1" Height="3" VerticalAlignment="Top" Panel.ZIndex="10" ClipToBounds="True" IsHitTestVisible="False"
          Visibility="Collapsed" SizeChanged="LoadBar_SizeChanged">
      <Rectangle x:Name="LoadRun" Width="260" HorizontalAlignment="Left">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#003CC8B4" Offset="0"/><GradientStop Color="#3CC8B4" Offset="0.5"/><GradientStop Color="#003CC8B4" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
        <Rectangle.RenderTransform><TranslateTransform x:Name="LoadRunX"/></Rectangle.RenderTransform>
      </Rectangle>
    </Grid>

    <!-- ===== Content ===== -->
    <DockPanel Grid.Row="1">
      <Border x:Name="IsaacBanner" DockPanel.Dock="Top" Background="#2A2315" BorderBrush="#4A3B1E" BorderThickness="0,0,0,1" Padding="32,11" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" FontSize="15" Margin="0,0,10,0"/>
          <TextBlock Foreground="#F1DEB4" Text="Isaac è aperto: chiudilo per cambiare mod o salvataggi (il gioco li legge all'avvio e li riscrive mentre gira)."/>
        </StackPanel>
      </Border>
      <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#14243F" BorderBrush="#24406B" BorderThickness="0,0,0,1" Padding="32,8" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Novità" Style="{StaticResource Ghost}" Padding="10,4" Click="UpdateNotes_Click" Margin="0,0,6,0"/>
            <Button Style="{StaticResource Primary}" Padding="12,4" Click="Update_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Aggiorna ora"/></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="#7FB0FF" FontSize="15" Margin="0,0,10,0"/>
            <TextBlock x:Name="UpdateBannerText" Foreground="#CFE0FF"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="PatchBanner" DockPanel.Dock="Top" Background="#2A2315" BorderBrush="#4A3B1E" BorderThickness="0,0,0,1" Padding="32,8" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="PatchBannerBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="12,4" Click="Patch_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Scarica la patch"/></StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" FontSize="15" Margin="0,0,10,0"/>
            <TextBlock x:Name="PatchBannerText" Foreground="#F1DEB4" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="DepBanner" DockPanel.Dock="Top" Background="#2A2315" BorderBrush="#4A3B1E" BorderThickness="0,0,0,1" Padding="32,8" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="12,4" Click="FixDeps_Click" ToolTip="Attiva le mod richieste spente e scarica dal Workshop quelle che mancano">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Sistema"/></StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" FontSize="15" Margin="0,0,10,0"/>
            <TextBlock x:Name="DepBannerText" Foreground="#F1DEB4" TextWrapping="Wrap" MaxWidth="680"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="BaseBanner" DockPanel.Dock="Top" Background="#14243F" BorderBrush="#24406B" BorderThickness="0,0,0,1" Padding="32,8" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Non ora" Style="{StaticResource Ghost}" Padding="10,4" Click="BaseLater_Click" Margin="0,0,6,0"/>
            <Button Style="{StaticResource Primary}" Padding="12,4" Click="InstallBase_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Scarica i fix"/></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="#7FB0FF" FontSize="15" Margin="0,0,10,0"/>
            <TextBlock x:Name="BaseBannerText" Foreground="#CFE0FF" TextWrapping="Wrap" MaxWidth="620"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="32,0,32,12" Style="{StaticResource Sub}" FontSize="12" Text="Pronto."/>

      <Grid Margin="32,28,24,8">
        <!-- Mod: the list in one card, on the right the state of the mods and the space they take -->
        <Grid x:Name="PageMods" Visibility="Collapsed" Margin="0,0,8,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
          <Grid.Resources>
            <Style x:Key="FlatItem" TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
              <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
              </Setter>
            </Style>
          </Grid.Resources>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top">
              <Grid DockPanel.Dock="Right" Width="300" VerticalAlignment="Bottom" Margin="16,0,0,2">
                <TextBox x:Name="ModsSearch" Tag="Cerca tra le mod" Padding="36,8,12,8" TextChanged="ModsSearch_TextChanged"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" FontSize="13" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
              </Grid>
              <StackPanel>
                <TextBlock x:Name="ModsEyebrow" Text="PROFILO" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Mod installate" Style="{StaticResource H1}"/>
                <TextBlock x:Name="ModsSummary" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,18,0,14">
              <RadioButton x:Name="FilterAll" Style="{StaticResource Pill}" GroupName="filter" Content="Tutte" IsChecked="True" Checked="Filter_Changed"/>
              <RadioButton x:Name="FilterOn" Style="{StaticResource Pill}" GroupName="filter" Content="Attive" Checked="Filter_Changed"/>
              <RadioButton x:Name="FilterOff" Style="{StaticResource Pill}" GroupName="filter" Content="Disattivate" Checked="Filter_Changed"/>
              <RadioButton x:Name="FilterUpd" Style="{StaticResource Pill}" GroupName="filter" Content="Da aggiornare" Checked="Filter_Changed" Margin="0"/>
            </StackPanel>
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0">
              <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer">
                  <Grid>
                    <ScrollContentPresenter Margin="0,0,16,0" CanContentScroll="False"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                  </Grid>
                </ControlTemplate>
              </ScrollViewer.Template>
            <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
            <Grid>
          <Border x:Name="ModsMask" CornerRadius="11" Background="{StaticResource Surface}"/>
          <ListBox x:Name="ModsList" Style="{StaticResource Plain}" ItemContainerStyle="{StaticResource FlatItem}">
            <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
            <ListBox.OpacityMask><VisualBrush Visual="{Binding ElementName=ModsMask}"/></ListBox.OpacityMask>
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="GroupItem">
                    <Setter Property="Template">
                      <Setter.Value><ControlTemplate TargetType="GroupItem"><ItemsPresenter/></ControlTemplate></Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Name}" Value="bto">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                              <StackPanel>
                                <ToggleButton x:Name="head" IsChecked="{Binding BtoOpen, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                              Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="Fix BTO automatici">
                                  <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                      <Border x:Name="bd" Background="#15181A" Padding="18,14">
                                        <ContentPresenter/>
                                      </Border>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </ToggleButton.Template>
                                  <DockPanel>
                                    <TextBlock x:Name="chev" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,2,0"/>
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                      <Run Text="Fix BTO automatici" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/><Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='   {0} '}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="12"/>
                                      <Run Text="  Seguono da sole le mod che sistemano: le attiva, disattiva e aggiorna BTO Sync." Foreground="{StaticResource Muted}" FontSize="12"/>
                                    </TextBlock>
                                  </DockPanel>
                                </ToggleButton>
                                <ItemsPresenter x:Name="items" Visibility="Collapsed"/>
                              </StackPanel>
                              <ControlTemplate.Triggers>
                                <Trigger SourceName="head" Property="IsChecked" Value="True">
                                  <Setter TargetName="items" Property="Visibility" Value="Visible"/>
                                  <Setter TargetName="chev" Property="Text" Value="&#xE70E;"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border x:Name="row" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,9" Background="Transparent">
                  <StackPanel>
                    <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ModRow_Click" Focusable="True" KeyDown="ModRow_KeyDown"
                          FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding NameText}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="Toggle_Click" IsEnabled="{Binding Switchable}"
                                VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="{Binding SwitchTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding NameText}"/>
                      <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,14,0">
                        <Grid>
                          <TextBlock Text="{Binding OriginIcon}" Style="{StaticResource Icon}" FontSize="16" Foreground="{Binding OriginBrush}" HorizontalAlignment="Center" Opacity="0.8"/>
                          <Border CornerRadius="8" Visibility="{Binding HasPreview, Converter={StaticResource Vis}}">
                            <Border.Background><ImageBrush ImageSource="{Binding Preview, TargetNullValue={x:Null}}" Stretch="UniformToFill"/></Border.Background>
                          </Border>
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NameText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Sub}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Border Grid.Column="3" Style="{StaticResource Badge}" BorderBrush="{Binding OriginBrush}" Margin="12,0,16,0">
                        <TextBlock Text="{Binding Origin}" Foreground="{Binding OriginBrush}" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="5" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,2,0" ToolTip="Dettagli"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}"><Setter TargetName="row" Property="BorderThickness" Value="0"/></DataTrigger>
                  <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Surface2}"/></Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
            </Grid>
            </Border>
            </ScrollViewer>
          </DockPanel>

          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Stato delle mod" Style="{StaticResource H2}"/>
                  <ItemsControl x:Name="HealthList" Margin="0,4,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,10,0,0">
                          <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" FontSize="12" Margin="0,1,0,0"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="UpdateAllBtn" Style="{StaticResource Primary}" Click="UpdateAll_Click" Margin="0,16,0,0" Padding="14,9" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock x:Name="UpdateAllText" Text="Aggiorna tutte"/></StackPanel>
                  </Button>
                  <Button x:Name="CheckUpdBtn" Style="{StaticResource Btn}" Click="CheckUpdates_Click" Margin="0,8,0,0" Padding="14,9"
                          ToolTip="Rilegge la cartella mods e controlla se ci sono versioni nuove delle mod del Workshop e di BTO Sync">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock x:Name="CheckUpdText" Text="Cerca aggiornamenti"/></StackPanel>
                  </Button>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="Spazio occupato" Style="{StaticResource H2}"/>
                  <TextBlock x:Name="SpaceText" Text="…" Style="{StaticResource Num}" FontSize="22" Margin="0,8,0,0"/>
                  <Border CornerRadius="4" Height="8" Margin="0,10,0,0" Background="{StaticResource Line}" ClipToBounds="True">
                    <Grid x:Name="SpaceBar"/>
                  </Border>
                  <ItemsControl x:Name="SpaceList" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,6,0,0">
                          <Rectangle DockPanel.Dock="Left" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Dot}" Margin="0,0,10,0"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Sub}" Style="{StaticResource Num}" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0"/>
                          <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Button Style="{StaticResource Btn}" Click="OpenDir_Click" Margin="0,16,0,0" Padding="14,9">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Apri la cartella mods"/></StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Workshop -->
        <DockPanel x:Name="PageWs" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,8,0">
            <TextBlock Text="STEAM WORKSHOP · REPENTANCE+" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Trova nuove mod" Style="{StaticResource H1}"/>
            <TextBlock x:Name="WsInfo" Style="{StaticResource Sub}" Margin="0,3,0,0" Text="Cerca e installa mod dal Workshop di Steam."/>
          </StackPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,18,8,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
              <Button x:Name="SortBtn" Style="{StaticResource Btn}" Click="Sort_Click" Margin="0,0,8,0" ToolTip="Come ordinare le mod" AutomationProperties.Name="Ordina">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                  <TextBlock x:Name="SortText" Text="Più popolari · settimana"/>
                  <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="9,1,0,0" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </Button>
              <Button x:Name="TagsBtn" Style="{StaticResource Btn}" Click="Filters_Click" ToolTip="Filtra per tag, come su Steam" AutomationProperties.Name="Tag">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                  <TextBlock x:Name="FiltersText" Text="Tag"/>
                  <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="9,1,0,0" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </Button>
              <Popup x:Name="TagsPopup" PlacementTarget="{Binding ElementName=TagsBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,12,16,16" Margin="10,6,10,14" Width="540">
                  <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.45" Color="Black"/></Border.Effect>
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Togli tutti" Style="{StaticResource Ghost}" Padding="10,3" Click="ClearTags_Click"/>
                      <StackPanel>
                        <TextBlock Text="Tag" Style="{StaticResource H2}" FontSize="14"/>
                        <TextBlock Text="Mostra solo le mod che hanno tutti i tag scelti. I tag li sceglie l'autore della mod." Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                    <ItemsControl x:Name="TagsList" Margin="0,4,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate><CheckBox Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding On, Mode=TwoWay}" Click="Tag_Click"/></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>
            <Grid>
              <TextBox x:Name="SearchBox" Tag="Cerca mod nel Workshop di Isaac" Padding="36,8,12,8" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
              <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" FontSize="13" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>
          </DockPanel>
          <ItemsControl x:Name="ActiveTags" DockPanel.Dock="Top" Margin="0,4,8,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding On, Mode=TwoWay}" Click="Tag_Click" ToolTip="Togli questo filtro" AutomationProperties.Name="{Binding Label}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}"/>
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9" Margin="8,1,0,0"/>
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border DockPanel.Dock="Top" Height="14"/>
          <Button x:Name="MoreBtn" DockPanel.Dock="Bottom" Content="Mostra altri risultati" Style="{StaticResource Btn}" HorizontalAlignment="Center"
                  Margin="0,6,0,0" Click="More_Click" Visibility="Collapsed"/>
          <Grid>
            <StackPanel x:Name="WsIsaac" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" MaxWidth="460" Visibility="Collapsed">
              <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"/>
              <TextBlock Text="Chiudi Isaac per usare il Workshop" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
              <TextBlock Style="{StaticResource Sub}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                         Text="Per cercare e installare mod BTO Sync si collega a Steam come Isaac, e mentre il gioco è aperto non può farlo. Quando chiudi Isaac il Workshop riparte da solo."/>
            </StackPanel>
            <StackPanel x:Name="WsEmpty" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Visibility="Collapsed">
              <TextBlock Text="Nessuna mod trovata" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="WsEmptySub" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,6,0,0" Text="Prova con meno tag o con altre parole."/>
              <Button x:Name="WsEmptyClear" Content="Togli i tag" Style="{StaticResource Btn}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="ClearTags_Click"/>
            </StackPanel>
            <ListBox x:Name="WsList" Style="{StaticResource Plain}" ItemContainerStyle="{StaticResource TileItem}" SizeChanged="WsList_SizeChanged" Tag="5">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Top"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="tile" Style="{StaticResource RowCard}" Padding="0" Cursor="Hand" MouseLeftButtonUp="WsTile_Click"
                          Focusable="True" KeyDown="WsTile_KeyDown" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding Title}">
                    <StackPanel>
                      <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                        <Border CornerRadius="9,9,0,0" Background="{StaticResource Surface2}"/>
                        <Border CornerRadius="9,9,0,0">
                          <Border.Background><ImageBrush ImageSource="{Binding Preview, TargetNullValue={x:Null}}" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <Border Background="#E6101318" CornerRadius="6" Padding="7,3,8,4" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="{Binding Installed, Converter={StaticResource Vis}}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Ok}" Margin="0,0,6,0"/>
                            <TextBlock Text="Installata" Foreground="{StaticResource Fg}" FontSize="11" FontWeight="SemiBold"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                      <StackPanel x:Name="info" Margin="12,10,12,12">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="38" LineHeight="19"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                          <StackPanel Orientation="Horizontal" Visibility="{Binding HasScore, Converter={StaticResource Vis}}" ToolTip="Voti positivi su Steam" Margin="0,0,14,0">
                            <TextBlock Text="&#xE8E1;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Sub}" FontSize="12"/>
                          </StackPanel>
                          <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,5,0" ToolTip="Iscritti"/>
                          <TextBlock Text="{Binding SubsShort}" Style="{StaticResource Sub}" FontSize="12" ToolTip="Iscritti"/>
                        </StackPanel>
                        <WrapPanel Margin="0,8,0,0">
                          <Border x:Name="kind" CornerRadius="5" Padding="7,2,7,3" Margin="0,0,5,0" Background="#1B2D4D" Visibility="{Binding HasKind, Converter={StaticResource Vis}}">
                            <TextBlock x:Name="kindText" Text="{Binding KindText}" FontSize="11" Foreground="#CFE0FF"/>
                          </Border>
                          <Border CornerRadius="5" Padding="7,2,7,3" Background="#2A2315" Visibility="{Binding NeedsOthers, Converter={StaticResource Vis}}"
                                  ToolTip="Su Steam richiede altre mod: BTO Sync le installa insieme">
                            <TextBlock Text="Richiede altre mod" FontSize="11" Foreground="#F1DEB4"/>
                          </Border>
                        </WrapPanel>
                        <DockPanel Margin="0,10,0,0">
                          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" IsEnabled="{Binding CanAct}" Click="WsAddMenu_Click" Padding="9,6" Margin="6,0,0,0"
                                  ToolTip="Aggiungi a un altro profilo, senza cambiare le mod attive adesso" AutomationProperties.Name="Aggiungi a un altro profilo">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/>
                          </Button>
                          <Button Content="{Binding ButtonText}" Style="{StaticResource Btn}" IsEnabled="{Binding CanAct}" Click="WsAct_Click" Padding="10,6"
                                  ToolTip="Vale per il profilo attivo" AutomationProperties.Name="{Binding ButtonText}"/>
                        </DockPanel>
                        <ProgressBar Maximum="1" Value="{Binding Progress}" Margin="0,8,0,0" Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                        <TextBlock x:Name="tileErr" Text="{Binding Error}" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                      </StackPanel>
                      <StackPanel x:Name="skel" Margin="12,12,12,16" Visibility="Collapsed">
                        <Border Height="12" CornerRadius="4" Background="{StaticResource Surface2}" Margin="0,0,40,8"/>
                        <Border Height="12" CornerRadius="4" Background="{StaticResource Surface2}" Margin="0,0,90,14"/>
                        <Border Height="16" Width="70" CornerRadius="5" Background="{StaticResource Surface2}" HorizontalAlignment="Left"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter TargetName="tileErr" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding Error}" Value=""><Setter TargetName="tileErr" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsVisualOnly}" Value="False">
                      <Setter TargetName="kind" Property="Background" Value="{StaticResource Surface2}"/><Setter TargetName="kindText" Property="Foreground" Value="{StaticResource Body}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Skeleton}" Value="True">
                      <Setter TargetName="info" Property="Visibility" Value="Collapsed"/><Setter TargetName="skel" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="tile" Property="Cursor" Value="Arrow"/>
                      <DataTrigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="tile" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="Forever"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>

        <!-- Partita: joining a friend's game in three steps (code, align, play); on the right the host's side -->
        <Grid x:Name="PageOnline" Margin="0,0,8,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
          <Grid.Resources>
            <!-- the number of a step: Tag = its number; MainWindow.SetStep paints it (to do, now, done) -->
            <Style x:Key="StepDot" TargetType="Border">
              <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="CornerRadius" Value="16"/>
              <Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,0,16,0"/>
            </Style>
          </Grid.Resources>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,8,8">
              <TextBlock Text="PROSSIMA PARTITA" Style="{StaticResource Eyebrow}"/>
              <TextBlock x:Name="OnlineTitle" Text="Entra nella partita di un amico" Style="{StaticResource H1}" TextWrapping="Wrap"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Online tutti devono avere le stesse mod dell'host, alla stessa versione: altrimenti la partita si divide."/>

              <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <DockPanel>
                  <Border x:Name="Step1" Style="{StaticResource StepDot}" Tag="1" DockPanel.Dock="Left"/>
                  <StackPanel>
                    <TextBlock Text="Incolla il codice dell'host" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0" Text="L'host lo copia da qui e lo manda su Discord. Se è già negli appunti lo leggo da solo."/>
                    <DockPanel Margin="0,12,0,0">
                      <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Paste_Click" VerticalAlignment="Top" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Incolla"/></StackPanel>
                      </Button>
                      <TextBox x:Name="CodeBox" Height="58" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="CodeBox_TextChanged"
                               FontFamily="{StaticResource Mono}" FontSize="12" Tag="BTO3:…" Background="{StaticResource Bg}" AutomationProperties.Name="Codice dell'host"/>
                    </DockPanel>
                    <TextBlock x:Name="CodeError" Foreground="{StaticResource Warn}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border x:Name="Step2Card" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                  <Border x:Name="Step2" Style="{StaticResource StepDot}" Tag="2" DockPanel.Dock="Left"/>
                  <StackPanel>
                    <DockPanel>
                      <Button x:Name="ApplyBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="Apply_Click" VerticalAlignment="Center" Padding="18,9" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Allinea ora"/></StackPanel>
                      </Button>
                      <Button x:Name="SaveHostBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="SaveHostProfile_Click" VerticalAlignment="Center" Margin="0,0,8,0"
                              ToolTip="Crea un profilo con le mod dell'host, senza cambiare niente adesso" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Salva come profilo"/></StackPanel>
                      </Button>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PlanTitle" Text="Allinea le mod" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="PlanSub" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                      </StackPanel>
                    </DockPanel>
                    <StackPanel x:Name="PlanCard" Visibility="Collapsed">
                      <ItemsControl x:Name="NotesList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{StaticResource WarnSoft}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                              <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="13"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl x:Name="PlanList" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="2,10">
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding KindIcon}" Style="{StaticResource Icon}" Foreground="{Binding KindBrush}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" Style="{StaticResource Sub}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="12,0,0,0"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                  <Border x:Name="Step3" Style="{StaticResource StepDot}" Tag="3" DockPanel.Dock="Left"/>
                  <Button x:Name="PlanLaunchBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Launch_Click" VerticalAlignment="Center" Padding="18,9">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Avvia Isaac"/></StackPanel>
                  </Button>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Avvia Isaac" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="Step3Sub" Style="{StaticResource Sub}" Margin="0,3,0,0" Text="Con le stesse mod dell'host entri in partita senza che si divida."/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Sei tu l'host?" Style="{StaticResource H2}"/>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Copia il codice delle tue mod attive e mandalo su Discord: gli altri lo incollano qui a sinistra."/>
                  <Button Style="{StaticResource Btn}" HorizontalAlignment="Stretch" Margin="0,14,0,0" Padding="14,9" Click="Export_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Copia il mio codice"/></StackPanel>
                  </Button>
                  <TextBox x:Name="ExportBox" Height="58" Margin="0,12,0,0" TextWrapping="Wrap" IsReadOnly="True" Visibility="Collapsed"
                           VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Mono}" FontSize="12" Background="{StaticResource Bg}"/>
                  <TextBlock x:Name="ExportResult" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentText}" FontSize="13"/>
                  <ItemsControl x:Name="ExportWarn">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource WarnSoft}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                          <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="13"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border x:Name="LogCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Apri il log" Style="{StaticResource Ghost}" Padding="8,3" FontSize="12" Click="OpenLog_Click"
                            ToolTip="Il log.txt del gioco: contiene anche i nomi e gli Steam ID dei giocatori della partita"/>
                    <TextBlock Text="Ultima partita" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock x:Name="LogWhen" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0"/>
                  <ItemsControl x:Name="LogList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,10,0,0">
                          <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" FontSize="12" Margin="0,1,0,0"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <DockPanel x:Name="LogSend" Margin="0,12,0,0" Visibility="Collapsed">
                    <Ellipse x:Name="LogSendDot" DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,12,0"/>
                    <TextBlock x:Name="LogSendText" Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Profili -->
        <DockPanel x:Name="PageProfiles" Visibility="Collapsed" Margin="0,0,8,0">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="ELENCHI DI MOD DA RIUSARE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Profili" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0" Text="Un profilo è un elenco di mod attive: salvane più di uno e passa dall'uno all'altro con un clic."/>
          </StackPanel>
          <Grid DockPanel.Dock="Top" Margin="0,18,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,14">
              <StackPanel>
                <TextBlock Text="Nuovo profilo" Style="{StaticResource H2}" FontSize="14" Margin="0,0,0,10"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Salva le mod attive" Style="{StaticResource Primary}" Click="NewProfile_Click" Margin="8,0,0,0"/>
                  <TextBox x:Name="NewProfileName" Tag="Nome, es. Run con The Future"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
              <StackPanel>
                <TextBlock Text="Importa un codice" Style="{StaticResource H2}" FontSize="14" Margin="0,0,0,10"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Importa" Style="{StaticResource Btn}" Click="ImportProfile_Click" Margin="8,0,0,0"/>
                  <TextBox x:Name="ImportBox" Tag="BTO3:…" FontFamily="Consolas" FontSize="12"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock x:Name="ProfilesEmpty" DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="2,4,0,0"
                     Text="Nessun profilo ancora: attiva le mod che vuoi e salvale come profilo."/>
          <ListBox x:Name="ProfilesList" Style="{StaticResource Plain}" ItemContainerStyle="{StaticResource CardItem}" Margin="0,0,-8,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RowCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,10,0">
                      <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Inline}" MinWidth="160" LostFocus="ProfileName_LostFocus"
                                 ToolTip="Clicca per rinominare"/>
                        <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource Ok}" Margin="6,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                          <TextBlock Text="Attivo" Foreground="{StaticResource Ok}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Sub}" FontSize="12" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="{Binding ApplyText}" Click="ApplyProfile_Click" Margin="0,0,8,0"
                              ToolTip="Attiva le mod di questo profilo e disattiva le altre">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <Button Style="{StaticResource Btn}" Click="ProfileMenu_Click" Padding="10,7" ToolTip="Altre azioni: codice, sostituisci, elimina"
                              AutomationProperties.Name="Altre azioni sul profilo">
                        <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="13"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Salvataggi -->
        <DockPanel x:Name="PageSaves" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,8,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="OpenBackups_Click" VerticalAlignment="Center" ToolTip="Apri la cartella dei backup di BTO Sync">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Cartella backup"/></StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="ImportSave_Click" VerticalAlignment="Center" Margin="0,0,8,0"
                    ToolTip="Aggiungi ai backup un salvataggio esportato da BTO Sync (.zip) o un file del gioco (.dat)">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Importa"/></StackPanel>
            </Button>
            <StackPanel>
              <TextBlock Text="3 SLOT · CON I DATI DELLE MOD" Style="{StaticResource Eyebrow}"/>
              <TextBlock Text="Salvataggi" Style="{StaticResource H1}"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0" Text="I 3 slot di Isaac, con i dati che le mod salvano per ogni slot. Prima di sovrascrivere uno slot BTO Sync ne salva un backup."/>
            </StackPanel>
          </DockPanel>
          <ItemsControl x:Name="SlotsList" DockPanel.Dock="Top" Margin="0,18,0,0" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="card" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,16" Cursor="Hand" Focusable="True"
                        MouseLeftButtonUp="Slot_Click" KeyDown="Slot_KeyDown" FocusVisualStyle="{StaticResource FocusRing}"
                        ToolTip="Clicca per vedere il percorso: boss battuti e personaggi" AutomationProperties.Name="{Binding Title}">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock x:Name="chev" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/>
                      <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" BorderBrush="{StaticResource Warn}" Background="{StaticResource WarnSoft}"
                              Visibility="{Binding HasRun, Converter={StaticResource Vis}}" ToolTip="C'è una partita salvata da continuare">
                        <TextBlock Text="Partita in corso" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Margin="0,14,0,0">
                      <Run Text="{Binding AchText, Mode=OneWay}" FontSize="26" FontFamily="{StaticResource Mono}"/><Run Text="  obiettivi" Foreground="{StaticResource Muted}" FontSize="13"/>
                    </TextBlock>
                    <ProgressBar Value="{Binding AchPct, Mode=OneWay}" Maximum="100" Margin="0,8,0,12"/>
                    <TextBlock Text="{Binding Line1}" Foreground="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Line2}" Foreground="{StaticResource Body}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Sub}" FontSize="12" Margin="0,8,0,14"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource Btn}" Click="SlotBackup_Click" IsEnabled="{Binding Exists}" Margin="0,0,6,0" Padding="11,7" ToolTip="Salva una copia dello slot com'è adesso">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Backup"/></StackPanel>
                      </Button>
                      <Button Style="{StaticResource Btn}" Click="SlotCopy_Click" IsEnabled="{Binding Exists}" Padding="11,7" ToolTip="Copia questo slot in un altro slot">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Copia in…"/></StackPanel>
                      </Button>
                      <Button Style="{StaticResource Btn}" Click="SlotExport_Click" IsEnabled="{Binding Exists}" Margin="6,0,0,0" Padding="9,7"
                              ToolTip="Esporta lo slot in un file, da tenere o da mandare a un amico" AutomationProperties.Name="Esporta in un file">
                        <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="12"/>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="chev" Property="Text" Value="&#xE70E;"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="SavesDirText" DockPanel.Dock="Bottom" Style="{StaticResource Sub}" FontSize="12" Margin="2,6,8,0" TextTrimming="CharacterEllipsis"/>
          <Grid Margin="0,18,8,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
            <Border x:Name="ProgressNone" Style="{StaticResource Card}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Percorso" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Clicca uno slot per vedere i boss battuti e i personaggi."/>
              </StackPanel>
            </Border>
          <ScrollViewer x:Name="ProgressPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,8,8">
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="CloseProgress_Click" Margin="16,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/><TextBlock Text="Chiudi"/></StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="12" Height="12" CornerRadius="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Bg}" Margin="0,0,6,0"/>
                  <TextBlock Text="Non battuto" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,14,0"/>
                  <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource Body}" Margin="0,0,6,0"/>
                  <TextBlock Text="Battuto" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,14,0"/>
                  <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,6,0"/>
                  <TextBlock Text="In difficile" Style="{StaticResource Sub}" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="ProgressTitle" Style="{StaticResource H2}" VerticalAlignment="Center"/>
              </DockPanel>
              <Border Style="{StaticResource Card}" Padding="22,20">
                <Canvas x:Name="ProgressTree" Width="770" Height="290" HorizontalAlignment="Left"/>
              </Border>
              <TextBlock x:Name="ProgressHint" Foreground="{StaticResource Body}" Margin="2,16,0,10" TextWrapping="Wrap"/>
              <StackPanel x:Name="CharsBox">
                <TextBlock Text="PERSONAGGI" Style="{StaticResource Label}" Margin="2,0,0,8"/>
                <WrapPanel x:Name="CharsGrid"/>
                <TextBlock Text="TAINTED" Style="{StaticResource Label}" Margin="2,8,0,8"/>
                <WrapPanel x:Name="TaintedGrid"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
            <DockPanel Grid.Column="2">
              <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
                <DockPanel>
                  <CheckBox x:Name="AutoBackupBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="AutoBackup_Click"
                            AutomationProperties.Name="Backup prima di giocare"/>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Backup prima di giocare" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" Text="Avvia Isaac salva prima gli slot cambiati dall'ultima volta. Tengo gli ultimi 5 per slot."/>
                  </StackPanel>
                </DockPanel>
              </Border>
          <StackPanel x:Name="BackupsHeader" DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Backup" Style="{StaticResource H2}"/>
            <TextBlock x:Name="BackupsCount" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0"/>
          </StackPanel>
          <TextBlock x:Name="BackupsEmpty" DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="2,0,0,0"
                     Text="Nessun backup ancora: premi Backup su uno slot."/>
          <ListBox x:Name="BackupsList" Style="{StaticResource Plain}" ItemContainerStyle="{StaticResource CardItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RowCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource Btn}" Click="BackupRestore_Click" Margin="8,0,6,0" Padding="10,7" ToolTip="Ripristina in uno slot…"
                              AutomationProperties.Name="Ripristina in uno slot">
                        <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="12"/>
                      </Button>
                      <Button Style="{StaticResource Danger}" Click="BackupDelete_Click" ToolTip="Elimina il backup" AutomationProperties.Name="Elimina il backup"
                              Visibility="{Binding DeleteVis}">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>

        <!-- Info -->
        <ScrollViewer x:Name="PageInfo" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,8,0">
            <StackPanel.Resources>
              <Style x:Key="Point" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Body}"/><Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="20"/><Setter Property="Margin" Value="0,10,0,0"/>
              </Style>
            </StackPanel.Resources>
            <TextBlock Text="BETTERTBOIONLINE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Info su BTO Sync" Style="{StaticResource H1}"/>
            <TextBlock x:Name="InfoVersion" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,10,0"/>
                    <TextBlock Text="Come funziona" Style="{StaticResource H2}"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Point}" Text="Attiva e disattiva le mod con il file disable.it, come il menu Mods del gioco: non cancella nulla."/>
                  <TextBlock Style="{StaticResource Point}" Text="Le mod del Workshop passano dal tuo client Steam; le mod BTO arrivano dalle release GitHub di questo progetto, ognuna insieme alla mod che sistema."/>
                  <TextBlock Style="{StaticResource Point}" Text="Il codice dell'host contiene solo l'elenco delle mod (nome, versione, hash dei file): niente dati personali."/>
                  <TextBlock Style="{StaticResource Point}" Text="Prima di sovrascrivere un salvataggio ne fa sempre un backup."/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" Foreground="{StaticResource Ok}" FontSize="15" Margin="0,0,10,0"/>
                    <TextBlock Text="Perché è sicuro" Style="{StaticResource H2}"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Point}" Text="Il codice è pubblico su GitHub: chiunque può leggerlo e compilarlo."/>
                  <TextBlock Style="{StaticResource Point}" Text="Niente password, account o telemetria: parla solo con GitHub, con l'API pubblica di Steam e con il tuo client Steam."/>
                  <TextBlock Style="{StaticResource Point}" Text="Non modifica isaac-ng.exe: controlla solo se c'è la patch per l'online, che applica Isaac-Online-Modded se lo scarichi tu."/>
                  <TextBlock Style="{StaticResource Point}" Text="Non si installa e non chiede i permessi di amministratore: per toglierlo basta cancellare la sua cartella."/>
                  <TextBlock Style="{StaticResource Point}" Text="L'exe non ha una firma digitale: per questo Windows può dire &quot;PC protetto&quot;."/>
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Style="{StaticResource Primary}" Click="InfoDoc_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Leggi tutto su GitHub"/></StackPanel>
              </Button>
              <Button Style="{StaticResource Btn}" Click="InfoSource_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Codice sorgente"/></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Impostazioni -->
        <StackPanel x:Name="PageSettings" Visibility="Collapsed" Margin="0,0,8,0">
          <TextBlock Text="BTO SYNC" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="Impostazioni" Style="{StaticResource H1}"/>
          <Border Style="{StaticResource Card}" Margin="0,18,0,12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Apri" Style="{StaticResource Btn}" Click="OpenDir_Click" Margin="0,0,8,0"/>
                <Button Content="Cambia" Style="{StaticResource Btn}" Click="ChangeDir_Click"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Cartella mods di Isaac" Style="{StaticResource H2}" FontSize="14"/>
                <TextBlock x:Name="ModsDirText" Style="{StaticResource Sub}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border x:Name="LogsCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
              <CheckBox x:Name="LogsBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Logs_Click"
                        AutomationProperties.Name="Invia i log delle partite con errori"/>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Invia i log delle partite con errori" Style="{StaticResource H2}" FontSize="14"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Dopo un desync o un errore Lua, chiuso Isaac, invio il log dell'ultima partita per confrontarlo con quello degli altri giocatori. Lo pulisco prima qui sul PC: niente Steam ID, nomi dei giocatori e cartella utente."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
              <Button x:Name="SettingsDisconnect" DockPanel.Dock="Right" Content="Scollega" Style="{StaticResource Btn}" Click="Disconnect_Click" VerticalAlignment="Center" Visibility="Collapsed"/>
              <StackPanel>
                <TextBlock Text="Steam" Style="{StaticResource H2}" FontSize="14"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                           Text="Per cercare e installare dal Workshop BTO Sync si collega a Steam come Isaac: finché è collegato i tuoi amici ti vedono in gioco su Isaac. Si scollega da solo quando avvii il gioco."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
              <Button x:Name="PatchBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Patch_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Scarica la patch"/></StackPanel>
              </Button>
              <StackPanel>
                <TextBlock Text="Patch per l'online con le mod" Style="{StaticResource H2}" FontSize="14"/>
                <TextBlock x:Name="PatchText" Style="{StaticResource Sub}" Margin="0,4,12,0" TextWrapping="Wrap" Text="Controllo isaac-ng.exe…"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateNowBtn" Style="{StaticResource Primary}" Click="Update_Click" Margin="0,0,8,0" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock x:Name="UpdateNowText" Text="Aggiorna"/></StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Click="CheckUpdate_Click" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Controlla"/></StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Click="GitHub_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="GitHub"/></StackPanel>
                </Button>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="AboutText" Text="BTO Sync" Style="{StaticResource H2}" FontSize="14"/>
                <TextBlock x:Name="UpdateText" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Aggiornamenti da GitHub (MICHELOSCO/BetterTBOIOnline): controllo all'avvio."/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
