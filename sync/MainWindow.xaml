<Window x:Class="BtoSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BTO Sync" Width="1200" Height="780" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Fg}" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition/></Grid.ColumnDefinitions>

    <!-- ===== Sidebar ===== -->
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,16">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="6,0,0,26">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Accent}">
              <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="White" FontSize="17" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="BTO Sync" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="mod manager per Isaac" Style="{StaticResource Sub}" FontSize="12"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="PROFILO" Style="{StaticResource Label}"/>
          <Border Style="{StaticResource RowCard}" Padding="12,10" Margin="0,0,0,22" Cursor="Hand" MouseLeftButtonUp="ProfileCard_Click"
                  ToolTip="Gestisci i profili">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}"/>
              <StackPanel>
                <TextBlock x:Name="ActiveProfileText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ActiveProfileSub" Style="{StaticResource Sub}" FontSize="12"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock Text="MENU" Style="{StaticResource Label}"/>
          <RadioButton x:Name="NavMods" Style="{StaticResource Nav}" Tag="&#xE8F1;" Content="Le mie mod" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavWs" Style="{StaticResource Nav}" Tag="&#xE774;" Content="Workshop" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavOnline" Style="{StaticResource Nav}" Tag="&#xE716;" Content="Gioca online" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavProfiles" Style="{StaticResource Nav}" Tag="&#xE8B9;" Content="Profili" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavSaves" Style="{StaticResource Nav}" Tag="&#xE74E;" Content="Salvataggi" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Impostazioni" Checked="Nav_Checked"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <StackPanel x:Name="SteamBox" Orientation="Horizontal" Margin="6,0,0,10" Visibility="Collapsed"
                      ToolTip="Per il Workshop BTO Sync si collega a Steam come Isaac: finché è collegato risulti in gioco su Isaac.">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Ok}" VerticalAlignment="Center"/>
            <TextBlock Text="Collegato a Steam" Style="{StaticResource Sub}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
            <Button Content="Scollega" Style="{StaticResource Ghost}" Padding="8,2" FontSize="12" Margin="4,0,0,0" Click="Disconnect_Click"/>
          </StackPanel>
          <Button x:Name="LaunchBtn" Style="{StaticResource Primary}" Padding="14,11" Click="Launch_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/>
              <TextBlock Text="Avvia Isaac" FontSize="14"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>

    <!-- ===== Content ===== -->
    <DockPanel Grid.Column="1">
      <Border x:Name="IsaacBanner" DockPanel.Dock="Top" Background="#2A2315" BorderBrush="#4A3B1E" BorderThickness="0,0,0,1" Padding="32,11" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" FontSize="15" Margin="0,0,10,0"/>
          <TextBlock Foreground="#F1DEB4" Text="Isaac è aperto: chiudilo per cambiare mod o salvataggi (il gioco li legge all'avvio e li riscrive mentre gira)."/>
        </StackPanel>
      </Border>
      <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#14243F" BorderBrush="#24406B" BorderThickness="0,0,0,1" Padding="32,8" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Novità" Style="{StaticResource Ghost}" Padding="10,4" Click="UpdateNotes_Click" Margin="0,0,6,0"/>
            <Button Style="{StaticResource Primary}" Padding="12,4" Click="Update_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Aggiorna ora"/></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="#7FB0FF" FontSize="15" Margin="0,0,10,0"/>
            <TextBlock x:Name="UpdateBannerText" Foreground="#CFE0FF"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="PatchBanner" DockPanel.Dock="Top" Background="#2A2315" BorderBrush="#4A3B1E" BorderThickness="0,0,0,1" Padding="32,8" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="PatchBannerBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="12,4" Click="Patch_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Scarica la patch"/></StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" FontSize="15" Margin="0,0,10,0"/>
            <TextBlock x:Name="PatchBannerText" Foreground="#F1DEB4" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="32,0,32,12" Style="{StaticResource Sub}" FontSize="12" Text="Pronto."/>

      <Grid Margin="32,24,24,8">
        <!-- Le mie mod -->
        <DockPanel x:Name="PageMods">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="UpdateAllBtn" Style="{StaticResource Primary}" Click="UpdateAll_Click" Margin="0,0,8,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock x:Name="UpdateAllText" Text="Aggiorna tutte"/></StackPanel>
              </Button>
              <Button Style="{StaticResource Btn}" Click="Refresh_Click" ToolTip="Rileggi la cartella mods">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Ricarica"/></StackPanel>
              </Button>
              <Button Style="{StaticResource Btn}" Click="OpenDir_Click" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Cartella"/></StackPanel>
              </Button>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Le mie mod" Style="{StaticResource H1}"/>
              <TextBlock x:Name="ModsSummary" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,18,8,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <RadioButton x:Name="FilterAll" Style="{StaticResource Pill}" GroupName="filter" Content="Tutte" IsChecked="True" Checked="Filter_Changed"/>
              <RadioButton x:Name="FilterOn" Style="{StaticResource Pill}" GroupName="filter" Content="Attive" Checked="Filter_Changed"/>
              <RadioButton x:Name="FilterOff" Style="{StaticResource Pill}" GroupName="filter" Content="Disattivate" Checked="Filter_Changed"/>
              <RadioButton x:Name="FilterUpd" Style="{StaticResource Pill}" GroupName="filter" Content="Da aggiornare" Checked="Filter_Changed" Margin="0"/>
            </StackPanel>
            <Grid>
              <TextBox x:Name="ModsSearch" Tag="Cerca tra le mod installate" Padding="36,8,12,8" TextChanged="ModsSearch_TextChanged"/>
              <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" FontSize="13" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>
          </DockPanel>
          <ListBox x:Name="ModsList" Style="{StaticResource Plain}" ItemContainerStyle="{StaticResource CardItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RowCard}">
                  <StackPanel>
                    <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ModRow_Click" Focusable="True" KeyDown="ModRow_KeyDown"
                          FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding NameText}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="Toggle_Click" IsEnabled="{Binding Switchable}"
                                VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Attiva o disattiva" AutomationProperties.Name="{Binding NameText}"/>
                      <Border Grid.Column="1" Width="42" Height="42" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,14,0">
                        <Grid>
                          <TextBlock Text="{Binding OriginIcon}" Style="{StaticResource Icon}" FontSize="16" Foreground="{Binding OriginBrush}" HorizontalAlignment="Center" Opacity="0.8"/>
                          <Border CornerRadius="8" Visibility="{Binding HasPreview, Converter={StaticResource Vis}}">
                            <Border.Background><ImageBrush ImageSource="{Binding Preview, TargetNullValue={x:Null}}" Stretch="UniformToFill"/></Border.Background>
                          </Border>
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NameText}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Sub}" FontSize="12" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Border Grid.Column="3" Style="{StaticResource Badge}" BorderBrush="{Binding OriginBrush}" Margin="12,0,16,0">
                        <TextBlock Text="{Binding Origin}" Foreground="{Binding OriginBrush}" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="5" x:Name="chev" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,2,0"/>
                    </Grid>
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Margin="110,12,8,2">
                      <TextBlock Text="{Binding DescriptionText}" Foreground="{StaticResource Body}" TextWrapping="Wrap" LineHeight="21" MaxWidth="860" HorizontalAlignment="Left"/>
                      <TextBlock Text="{Binding DetailsText}" Style="{StaticResource Sub}" FontSize="12" Margin="0,12,0,0"/>
                      <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource Primary}" Click="UpdateMod_Click" Margin="0,0,8,0" IsEnabled="{Binding Unlocked}"
                                Visibility="{Binding CanUpdate, Converter={StaticResource Vis}}" Content="Aggiorna"/>
                        <Button Style="{StaticResource Btn}" Click="ModPage_Click" Margin="0,0,8,0" Visibility="{Binding HasPage, Converter={StaticResource Vis}}">
                          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Pagina Workshop"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Click="ModFolder_Click" Margin="0,0,8,0">
                          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Apri cartella"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Danger}" Click="ModRemove_Click" IsEnabled="{Binding Unlocked}" Visibility="{Binding CanRemove, Converter={StaticResource Vis}}">
                          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Disinstalla"/></StackPanel>
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter TargetName="chev" Property="Text" Value="&#xE70E;"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Workshop -->
        <DockPanel x:Name="PageWs" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,8,0">
            <TextBlock Text="Workshop" Style="{StaticResource H1}"/>
            <TextBlock x:Name="WsInfo" Style="{StaticResource Sub}" Margin="0,3,0,0" Text="Cerca e installa mod dal Workshop di Steam."/>
          </StackPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,18,8,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <RadioButton x:Name="SortTrend" Style="{StaticResource Pill}" GroupName="sort" Content="Di tendenza" IsChecked="True" Checked="Sort_Checked"/>
              <RadioButton x:Name="SortSubs" Style="{StaticResource Pill}" GroupName="sort" Content="Più iscritti" Checked="Sort_Checked"/>
              <RadioButton x:Name="SortNew" Style="{StaticResource Pill}" GroupName="sort" Content="Più recenti" Checked="Sort_Checked" Margin="0"/>
            </StackPanel>
            <Grid>
              <TextBox x:Name="SearchBox" Tag="Cerca mod nel Workshop di Isaac e premi Invio" Padding="36,8,12,8" KeyDown="SearchBox_KeyDown"/>
              <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" FontSize="13" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>
          </DockPanel>
          <Button x:Name="MoreBtn" DockPanel.Dock="Bottom" Content="Mostra altri risultati" Style="{StaticResource Btn}" HorizontalAlignment="Center"
                  Margin="0,6,0,0" Click="More_Click" Visibility="Collapsed"/>
          <ListBox x:Name="WsList" Style="{StaticResource Plain}" ItemContainerStyle="{StaticResource CardItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RowCard}">
                  <StackPanel>
                    <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="WsRow_Click" Focusable="True" KeyDown="WsRow_KeyDown"
                          FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding Title}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="72" Height="72" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,16,0">
                        <Grid>
                          <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Border CornerRadius="8">
                            <Border.Background><ImageBrush ImageSource="{Binding Preview, TargetNullValue={x:Null}}" Stretch="UniformToFill"/></Border.Background>
                          </Border>
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource Ok}" Margin="10,0,0,0" Visibility="{Binding Installed, Converter={StaticResource Vis}}">
                            <TextBlock Text="Installata" Foreground="{StaticResource Ok}" FontSize="11" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Body}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="38" Margin="0,4,0,4"/>
                        <TextBlock Text="{Binding SubsText}" Style="{StaticResource Sub}" FontSize="12"/>
                      </StackPanel>
                      <Button Grid.Column="2" x:Name="act" Content="{Binding ButtonText}" Style="{StaticResource Primary}" IsEnabled="{Binding CanAct}" Click="WsAct_Click"
                              VerticalAlignment="Center" MinWidth="104" Margin="16,0,8,0"/>
                      <TextBlock Grid.Column="3" x:Name="chev" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,0,2,0"/>
                    </Grid>
                    <ProgressBar Maximum="1" Value="{Binding Progress}" Margin="88,10,8,0" Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding Error}" Foreground="#F0616D" FontSize="12" TextWrapping="Wrap" Margin="88,6,8,0"/>
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Margin="88,10,8,2">
                      <TextBlock Text="{Binding LongDescription}" Foreground="{StaticResource Body}" TextWrapping="Wrap" LineHeight="21" MaxWidth="860" HorizontalAlignment="Left"/>
                      <Button Style="{StaticResource Btn}" Click="WsPage_Click" Margin="0,14,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Pagina Workshop"/></StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter TargetName="chev" Property="Text" Value="&#xE70E;"/></DataTrigger>
                  <DataTrigger Binding="{Binding Installed}" Value="True"><Setter TargetName="act" Property="Style" Value="{StaticResource Danger}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Gioca online -->
        <DockPanel x:Name="PageOnline" Visibility="Collapsed" Margin="0,0,8,0">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Gioca online" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0" Text="Online tutti devono avere le stesse mod dell'host, alla stessa versione: altrimenti la partita si divide."/>
          </StackPanel>
          <Grid DockPanel.Dock="Top" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="&#xE7EE;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,10,0"/>
                  <TextBlock Text="Sei l'host" Style="{StaticResource H2}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Sub}" Text="Copia il codice delle tue mod attive e incollalo su Discord: gli altri lo useranno per avere le tue stesse mod."/>
                <Button Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Export_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Copia il mio codice"/></StackPanel>
                </Button>
                <TextBox x:Name="ExportBox" Height="58" Margin="0,14,0,0" TextWrapping="Wrap" IsReadOnly="True" Visibility="Collapsed"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="{StaticResource Bg}"/>
                <TextBlock x:Name="ExportResult" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource Ok}" FontSize="13"/>
                <ItemsControl x:Name="ExportWarn">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource WarnSoft}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="13"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="&#xE8FB;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,10,0"/>
                  <TextBlock Text="Entri nella partita di un altro" Style="{StaticResource H2}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Sub}" Text="Incolla il codice dell'host: BTO Sync ti dice subito cosa cambiare e lo fa per te."/>
                <TextBox x:Name="CodeBox" Height="58" Margin="0,14,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="CodeBox_TextChanged"
                         FontFamily="Consolas" FontSize="12" Tag="BTO1:…" Background="{StaticResource Bg}" AutomationProperties.Name="Codice dell'host"/>
                <TextBlock x:Name="CodeError" Foreground="{StaticResource Warn}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Button Style="{StaticResource Btn}" Click="Paste_Click" HorizontalAlignment="Left" Margin="0,12,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Incolla"/></StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </Grid>
          <Border x:Name="PlanCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed" VerticalAlignment="Top">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <Button x:Name="ApplyBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="Apply_Click" VerticalAlignment="Center" Padding="18,9">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Allinea ora"/></StackPanel>
                </Button>
                <Button x:Name="PlanLaunchBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="Launch_Click" VerticalAlignment="Center" Padding="18,9" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Avvia Isaac"/></StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="PlanTitle" Style="{StaticResource H2}" FontSize="18"/>
                  <TextBlock x:Name="PlanSub" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
              <ItemsControl x:Name="NotesList" DockPanel.Dock="Top" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource WarnSoft}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                      <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="13"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ListBox x:Name="PlanList" Margin="0,12,0,0" Style="{StaticResource Plain}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardItem}"><Setter Property="Margin" Value="0,0,0,6"/></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,9">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding KindIcon}" Style="{StaticResource Icon}" Foreground="{Binding KindBrush}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" Style="{StaticResource Sub}" Margin="12,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </DockPanel>

        <!-- Profili -->
        <DockPanel x:Name="PageProfiles" Visibility="Collapsed" Margin="0,0,8,0">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Profili" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0" Text="Un profilo è un elenco di mod attive: salvane più di uno e passa dall'uno all'altro con un clic."/>
          </StackPanel>
          <Grid DockPanel.Dock="Top" Margin="0,18,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,14">
              <StackPanel>
                <TextBlock Text="Nuovo profilo" Style="{StaticResource H2}" FontSize="14" Margin="0,0,0,10"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Salva le mod attive" Style="{StaticResource Primary}" Click="NewProfile_Click" Margin="8,0,0,0"/>
                  <TextBox x:Name="NewProfileName" Tag="Nome, es. Run con The Future"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
              <StackPanel>
                <TextBlock Text="Importa un codice" Style="{StaticResource H2}" FontSize="14" Margin="0,0,0,10"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Importa" Style="{StaticResource Btn}" Click="ImportProfile_Click" Margin="8,0,0,0"/>
                  <TextBox x:Name="ImportBox" Tag="BTO1:…" FontFamily="Consolas" FontSize="12"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock x:Name="ProfilesEmpty" DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="2,4,0,0"
                     Text="Nessun profilo ancora: attiva le mod che vuoi e salvale come profilo."/>
          <ListBox x:Name="ProfilesList" Style="{StaticResource Plain}" ItemContainerStyle="{StaticResource CardItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RowCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,10,0">
                      <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Inline}" MinWidth="160" LostFocus="ProfileName_LostFocus"
                                 ToolTip="Clicca per rinominare"/>
                        <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource Accent}" Margin="6,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                          <TextBlock Text="Attivo" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Sub}" FontSize="12" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Applica" Style="{StaticResource Primary}" Click="ApplyProfile_Click" Margin="0,0,8,0"/>
                      <Button Style="{StaticResource Btn}" Click="ExportProfile_Click" Margin="0,0,8,0" ToolTip="Copia il codice del profilo da mandare agli altri">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Codice"/></StackPanel>
                      </Button>
                      <Button Style="{StaticResource Btn}" Click="OverwriteProfile_Click" Margin="0,0,8,0" ToolTip="Sostituisci con le mod attive adesso">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Salva attive"/></StackPanel>
                      </Button>
                      <Button Style="{StaticResource Danger}" Click="DeleteProfile_Click" ToolTip="Elimina il profilo (le mod restano installate)" AutomationProperties.Name="Elimina il profilo">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Salvataggi -->
        <DockPanel x:Name="PageSaves" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,8,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="OpenBackups_Click" VerticalAlignment="Center" ToolTip="Apri la cartella dei backup di BTO Sync">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Cartella backup"/></StackPanel>
            </Button>
            <StackPanel>
              <TextBlock Text="Salvataggi" Style="{StaticResource H1}"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0" Text="I 3 slot di Isaac, con i dati che le mod salvano per ogni slot. Prima di sovrascrivere uno slot BTO Sync ne salva un backup."/>
            </StackPanel>
          </DockPanel>
          <ItemsControl x:Name="SlotsList" DockPanel.Dock="Top" Margin="0,18,0,0" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="card" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,16" Cursor="Hand" Focusable="True"
                        MouseLeftButtonUp="Slot_Click" KeyDown="Slot_KeyDown" FocusVisualStyle="{StaticResource FocusRing}"
                        ToolTip="Clicca per vedere il percorso: boss battuti e personaggi" AutomationProperties.Name="{Binding Title}">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock x:Name="chev" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/>
                      <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" BorderBrush="{StaticResource Warn}" Background="{StaticResource WarnSoft}"
                              Visibility="{Binding HasRun, Converter={StaticResource Vis}}" ToolTip="C'è una partita salvata da continuare">
                        <TextBlock Text="Partita in corso" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Margin="0,14,0,0">
                      <Run Text="{Binding AchText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/><Run Text="  obiettivi" Foreground="{StaticResource Muted}" FontSize="13"/>
                    </TextBlock>
                    <ProgressBar Value="{Binding AchPct, Mode=OneWay}" Maximum="100" Margin="0,8,0,12"/>
                    <TextBlock Text="{Binding Line1}" Foreground="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Line2}" Foreground="{StaticResource Body}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Sub}" FontSize="12" Margin="0,8,0,14"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource Btn}" Click="SlotBackup_Click" IsEnabled="{Binding Exists}" Margin="0,0,8,0" ToolTip="Salva una copia dello slot com'è adesso">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Backup"/></StackPanel>
                      </Button>
                      <Button Style="{StaticResource Btn}" Click="SlotCopy_Click" IsEnabled="{Binding Exists}" ToolTip="Copia questo slot in un altro slot">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Copia in…"/></StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="#7FB0FF"/><Setter TargetName="chev" Property="Text" Value="&#xE70E;"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel x:Name="BackupsHeader" DockPanel.Dock="Top" Margin="0,24,8,10">
            <TextBlock x:Name="BackupsCount" DockPanel.Dock="Right" Style="{StaticResource Sub}" VerticalAlignment="Bottom"/>
            <TextBlock Text="Backup" Style="{StaticResource H2}"/>
          </DockPanel>
          <TextBlock x:Name="SavesDirText" DockPanel.Dock="Bottom" Style="{StaticResource Sub}" FontSize="12" Margin="2,6,8,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="BackupsEmpty" DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="2,0,0,0"
                     Text="Nessun backup ancora: premi Backup su uno slot."/>
          <Grid>
          <!-- Progress of the open slot: takes the place of the backup list -->
          <ScrollViewer x:Name="ProgressPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,24,0,0">
            <StackPanel Margin="0,0,8,8">
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="CloseProgress_Click" Margin="16,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/><TextBlock Text="Chiudi"/></StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="12" Height="12" CornerRadius="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Bg}" Margin="0,0,6,0"/>
                  <TextBlock Text="Non battuto" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,14,0"/>
                  <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource Body}" Margin="0,0,6,0"/>
                  <TextBlock Text="Battuto" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,14,0"/>
                  <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,6,0"/>
                  <TextBlock Text="In difficile" Style="{StaticResource Sub}" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="ProgressTitle" Style="{StaticResource H2}" VerticalAlignment="Center"/>
              </DockPanel>
              <Border Style="{StaticResource Card}" Padding="22,20">
                <Canvas x:Name="ProgressTree" Width="770" Height="290" HorizontalAlignment="Left"/>
              </Border>
              <TextBlock x:Name="ProgressHint" Foreground="{StaticResource Body}" Margin="2,16,0,10" TextWrapping="Wrap"/>
              <StackPanel x:Name="CharsBox">
                <TextBlock Text="PERSONAGGI" Style="{StaticResource Label}" Margin="2,0,0,8"/>
                <WrapPanel x:Name="CharsGrid"/>
                <TextBlock Text="TAINTED" Style="{StaticResource Label}" Margin="2,8,0,8"/>
                <WrapPanel x:Name="TaintedGrid"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <ListBox x:Name="BackupsList" Style="{StaticResource Plain}" ItemContainerStyle="{StaticResource CardItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RowCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource Btn}" Click="BackupRestore_Click" Margin="0,0,8,0" ToolTip="Rimetti questo backup in uno slot">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Ripristina in…"/></StackPanel>
                      </Button>
                      <Button Style="{StaticResource Danger}" Click="BackupDelete_Click" ToolTip="Elimina il backup" AutomationProperties.Name="Elimina il backup"
                              Visibility="{Binding DeleteVis}">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Grid>
        </DockPanel>

        <!-- Impostazioni -->
        <StackPanel x:Name="PageSettings" Visibility="Collapsed" Margin="0,0,8,0">
          <TextBlock Text="Impostazioni" Style="{StaticResource H1}"/>
          <Border Style="{StaticResource Card}" Margin="0,18,0,12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Apri" Style="{StaticResource Btn}" Click="OpenDir_Click" Margin="0,0,8,0"/>
                <Button Content="Cambia" Style="{StaticResource Btn}" Click="ChangeDir_Click"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Cartella mods di Isaac" Style="{StaticResource H2}" FontSize="14"/>
                <TextBlock x:Name="ModsDirText" Style="{StaticResource Sub}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
              <Button x:Name="SettingsDisconnect" DockPanel.Dock="Right" Content="Scollega" Style="{StaticResource Btn}" Click="Disconnect_Click" VerticalAlignment="Center" Visibility="Collapsed"/>
              <StackPanel>
                <TextBlock Text="Steam" Style="{StaticResource H2}" FontSize="14"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                           Text="Per cercare e installare dal Workshop BTO Sync si collega a Steam come Isaac: finché è collegato i tuoi amici ti vedono in gioco su Isaac. Si scollega da solo quando avvii il gioco."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
              <Button x:Name="PatchBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Patch_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Scarica la patch"/></StackPanel>
              </Button>
              <StackPanel>
                <TextBlock Text="Patch per l'online con le mod" Style="{StaticResource H2}" FontSize="14"/>
                <TextBlock x:Name="PatchText" Style="{StaticResource Sub}" Margin="0,4,12,0" TextWrapping="Wrap" Text="Controllo isaac-ng.exe…"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateNowBtn" Style="{StaticResource Primary}" Click="Update_Click" Margin="0,0,8,0" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock x:Name="UpdateNowText" Text="Aggiorna"/></StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Click="CheckUpdate_Click" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Controlla"/></StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Click="GitHub_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="GitHub"/></StackPanel>
                </Button>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="AboutText" Text="BTO Sync" Style="{StaticResource H2}" FontSize="14"/>
                <TextBlock x:Name="UpdateText" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Aggiornamenti da GitHub (MICHELOSCO/BetterTBOIOnline): controllo all'avvio."/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
